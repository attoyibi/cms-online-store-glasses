# ----------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API Keys
#
# Selama dua nilai ini kosong — atau sudah diisi tapi migrasi SQL di
# supabase/ belum dijalankan — situs otomatis memakai data contoh di
# src/lib/data/sample-data.ts, dan halaman admin menjelaskan apa yang
# masih kurang.
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik. Supabase kini menamainya "publishable key" (berawalan
# sb_publishable_); proyek lama memakai "anon key" berupa JWT panjang.
# Keduanya diterima — isi salah satu saja.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------
# Identitas toko
# ----------------------------------------------------------------
# Nomor WhatsApp tujuan pesanan. Format internasional tanpa tanda "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Domain produksi, dipakai untuk metadata & sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
