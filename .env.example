# ----------------------------------------------------------------
# Supabase — Dashboard → Project Settings → Data API / API Keys
# Selama dua nilai ini kosong, situs otomatis memakai data contoh
# di src/lib/data/sample-data.ts dan halaman admin dinonaktifkan.
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------
# Identitas toko
# ----------------------------------------------------------------
# Nomor WhatsApp tujuan pesanan. Format internasional tanpa tanda "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Domain produksi, dipakai untuk metadata & sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
